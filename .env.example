# Copia a .env.local para desarrollo. En Easypanel, cárgalas como variables de entorno.

# Postgres. En Easypanel usa el host interno del servicio, no localhost.
DATABASE_URL=postgres://usuario:clave@localhost:5432/pm_platform
# true solo si tu Postgres exige TLS (gestionados). En Easypanel interno, déjalo vacío.
DATABASE_SSL=

# Firma de la cookie de sesión. Mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# Usuario inicial, lo lee `npm run db:seed`.
PM_EMAIL=
PM_PASSWORD=
PM_NOMBRE=

# Zona horaria para fechas y recordatorios.
TZ_APP=America/Bogota

# --- Fase 3: ingesta con LLM (todavía no se usa) ---
ANTHROPIC_API_KEY=

# --- Fase 1/2: Slack (todavía no se usa) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CANAL=
